{
  "name": "pro-matrix-2024",
  "version": "2.1.31",
  "scripts": {
    "adr:": "",
    "new-adr": ".\\new-adr.cmd",
    "continue-adr": ".\\continue-adr.cmd",
    "remove-adr": ".\\remove-adr.cmd",
    "npm-functions": "npm.cmd --prefix \".\\functions\" install --no-audit --fund=false --loglevel=error",
    "start-server": "node scripts/start-server.js",
    "start-client": "ng serve --host=127.0.0.1 --port 4200",
    "watch-build-development": "ng build --watch --configuration development",
    "watch-build-production": "npm run prebuild && ng build --watch --configuration production",
    "prebuild": "npm --no-git-tag-version version patch",
    "build-development": "ng build --configuration development",
    "build-production": "npm run prebuild && ng build",
    "http-server-dist": "node ./node_modules/http-server/bin/http-server -p 7777 -c-1 dist/pro-matrix-2024/browser",
    "deploy-all": "npm run deploy-hosting && npm run deploy-functions",
    "deploy-hosting": "npm run build-production && node --no-deprecation ./node_modules/firebase-tools/lib/bin/firebase.js deploy --only hosting --project promatrix-us",
    "deploy-functions": "node --no-deprecation ./node_modules/firebase-tools/lib/bin/firebase.js deploy --only functions --project promatrix-us",
    "launch-hosting-from-firebase": "start chrome --app=https://promatrix-us.web.app --disk-cache-dir=null",
    "launch-get-function-from-firebase": "start chrome --app=https://helloworld-aytfenh5ja-uc.a.run.app/ --disk-cache-dir=null",
    "dashboard-on-firebase": "start chrome --new-window https://console.firebase.google.com/u/0/project/promatrix-us/overview",
    "start-2": "ng serve --host=127.0.0.1",
    "ng": "ng"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/animations": "22.1.1",
    "@angular/cdk": "22.1.1",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/material": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-browser-dynamic": "22.1.1",
    "@angular/router": "22.1.1",
    "firebase": "12.17.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "firebase-tools": "15.30.0",
    "http-server": "~14.1.1",
    "typescript": "~6.0.3"
  }
}
