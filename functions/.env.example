# SMTP configuration for the contact form (functions/sendSms).
# Copy this file to functions/.env and fill in real values.
# functions/.env is gitignored and must never be committed.
# The Firebase emulator automatically loads functions/.env on startup.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-app-password
SMTP_FROM=no-reply@promatrixinc.com
CONTACT_RECIPIENT=admin@promatrixinc.com
