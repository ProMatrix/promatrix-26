{
  "hosting": {
    "public": "dist/pro-matrix-2024/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/promatrix-us/us-central1/helloWorld",
        "function": "helloWorld"
      },
      {
        "source": "/promatrix-us/us-central1/getUtcDateTime",
        "function": "getUtcDateTime"
      },
      {
        "source": "/promatrix-us/us-central1/sendSms",
        "function": "sendSms"
      },
      {
        "source": "/promatrix-us/us-central1/getAudioFromText",
        "function": "getAudioFromText"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "emulators": {
    "hub": {
      "port": 4412
    },
    "hosting": {
      "port": 5012
    },
    "functions": {
      "port": 5013
    },
    "ui": {
      "enabled": true,
      "port": 4012
    },
    "logging": {
      "port": 4512
    },
    "eventarc": {
      "port": 9312
    },
    "tasks": {
      "port": 9512
    },
    "singleProjectMode": true
  }
}
